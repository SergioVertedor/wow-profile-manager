{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SergioVertedor/wow-profile-manager/blob/develop/docs/adaptador.schema.json",
  "title": "Addon adapter 1.x",
  "description": "Which part of an addon's SavedVariables travels in a .wowprofile. See docs/adapters.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "addon", "medido"],
  "if": {
    "required": ["reglas"],
    "properties": { "reglas": { "contains": { "anyOf": [{ "required": ["excluir"] }, { "required": ["entera"] }] } } }
  },
  "then": { "required": ["versionesAddon"] },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "addon": {
      "description": "Addon folder in Interface/AddOns.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_!.\\-]{1,64}$",
      "not": { "pattern": "^\\.+$" }
    },
    "versionesAddon": {
      "description": "Addon versions (## Version in the .toc) that were measured. With any other version, the entry is offered unchecked and with a warning.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "medido": {
      "description": "What was measured to write the adapter: keys seen and date.",
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "reglas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/regla" }
    },
    "noExportar": {
      "description": "The addon only stores state or other players' data: it is never offered.",
      "const": true
    }
  },
  "oneOf": [
    { "required": ["reglas"], "not": { "required": ["noExportar"] } },
    { "required": ["noExportar"], "not": { "required": ["reglas"] } }
  ],
  "$defs": {
    "ruta": {
      "description": "Keys separated by '/'. A segment is '*' (any key), '$PJ' (the character's key) or a literal name.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^(\\*|\\$PJ|[^/$*]+)(/(\\*|\\$PJ|[^/$*]+))*$"
    },
    "rutaConPersonaje": {
      "allOf": [
        { "$ref": "#/$defs/ruta" },
        { "pattern": "(^|/)\\$PJ($|/)" }
      ]
    },
    "listaRutas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ruta" }
    },
    "regla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambito", "variable"],
      "properties": {
        "ambito": { "enum": ["personaje", "cuenta"] },
        "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
        "entera": { "const": true },
        "incluir": { "$ref": "#/$defs/listaRutas" },
        "excluir": { "$ref": "#/$defs/listaRutas" },
        "perfilAcedb": { "const": true },
        "soloPersonaje": {
          "description": "Tables indexed by character: only the source character's entry travels, with its key changed to the target's.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rutaConPersonaje" }
        },
        "clavePersonaje": {
          "description": "How the addon writes the character key. By default, like AceDB in Forever.",
          "enum": ["nombre-apellido", "nombre-guion-reino"],
          "default": "nombre-apellido"
        }
      },
      "oneOf": [
        { "required": ["entera"] },
        { "required": ["incluir"] },
        { "required": ["excluir"] },
        { "required": ["perfilAcedb"] }
      ],
      "allOf": [
        {
          "if": { "required": ["perfilAcedb"] },
          "then": { "properties": { "ambito": { "const": "cuenta" } }, "not": { "required": ["soloPersonaje"] } }
        }
      ]
    }
  }
}
