{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Profile Manager",
  "version": "0.1.0",
  "identifier": "io.github.sergiovertedor.wowprofilemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "WoW Profile Manager",
        "width": 1024,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#0f1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
